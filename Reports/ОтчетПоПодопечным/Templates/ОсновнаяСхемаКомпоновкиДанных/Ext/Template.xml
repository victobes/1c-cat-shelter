		<query>ВЫБРАТЬ
	Кошки.Ссылка КАК Кошка,
	Кошки.Порода КАК Порода,
	Кошки.Окрас КАК Окрас,
	Кошки.Пол КАК Пол,
	Кошки.ТипШерсти КАК ТипШерсти,
	Кошки.Инвалидность КАК Инвалидность,
	Кошки.ДатаРождения КАК ДатаРождения,
	ВЫБОР
		КОГДА Кошки.ДатаРождения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ВЫБОР
					КОГДА МЕСЯЦ(&amp;Период) = МЕСЯЦ(Кошки.ДатаРождения)
							И ДЕНЬ(&amp;Период) &lt; ДЕНЬ(Кошки.ДатаРождения)
						ТОГДА ГОД(&amp;Период) - ГОД(Кошки.ДатаРождения) - 1
					КОГДА МЕСЯЦ(&amp;Период) = МЕСЯЦ(Кошки.ДатаРождения)
							И ДЕНЬ(&amp;Период) &gt; ДЕНЬ(Кошки.ДатаРождения)
						ТОГДА ГОД(&amp;Период) - ГОД(Кошки.ДатаРождения)
					КОГДА МЕСЯЦ(&amp;Период) &lt; МЕСЯЦ(Кошки.ДатаРождения)
						ТОГДА ГОД(&amp;Период) - ГОД(Кошки.ДатаРождения) - 1
					ИНАЧЕ ГОД(&amp;Период) - ГОД(Кошки.ДатаРождения)
				КОНЕЦ
		ИНАЧЕ -1
	КОНЕЦ КАК ВозрастЛет,
	ВЫБОР
		КОГДА Кошки.ДатаРождения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ВЫБОР
					КОГДА ДЕНЬ(&amp;Период) &gt;= ДЕНЬ(Кошки.ДатаРождения)
							И МЕСЯЦ(&amp;Период) &gt;= МЕСЯЦ(Кошки.ДатаРождения)
						ТОГДА МЕСЯЦ(&amp;Период) - МЕСЯЦ(Кошки.ДатаРождения)
					КОГДА МЕСЯЦ(&amp;Период) &gt; МЕСЯЦ(Кошки.ДатаРождения)
						ТОГДА МЕСЯЦ(&amp;Период) - МЕСЯЦ(Кошки.ДатаРождения) - 1
					КОГДА ДЕНЬ(&amp;Период) &gt;= ДЕНЬ(Кошки.ДатаРождения)
						ТОГДА 12 - (МЕСЯЦ(Кошки.ДатаРождения) - МЕСЯЦ(&amp;Период))
					ИНАЧЕ 12 - (МЕСЯЦ(Кошки.ДатаРождения) - МЕСЯЦ(&amp;Период) + 1)
				КОНЕЦ
		ИНАЧЕ -1
	КОНЕЦ КАК ВозрастМесяцев
ПОМЕСТИТЬ ВТ_Кошки
ИЗ
	Справочник.Кошки КАК Кошки
;

