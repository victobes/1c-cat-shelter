		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СтатусыМестаСодержанияЖивотныхСрезПоследних.Кошка КАК Кошка,
	СтатусыМестаСодержанияЖивотныхСрезПоследних.МестоСодержания КАК МестоСодержания
ПОМЕСТИТЬ ВТ_КошкиВПриюте
ИЗ
	РегистрСведений.СтатусыМестаСодержанияЖивотных.СрезПоследних(
			,
			НЕ Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПребыванияЖивотных.Укотовлен)
				И НЕ Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПребыванияЖивотных.Мертв)) КАК СтатусыМестаСодержанияЖивотныхСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_КошкиВПриюте.Кошка КАК Кошка,
	ВТ_КошкиВПриюте.МестоСодержания КАК МестоСодержания,
	РационыКормленияПодопечныхСрезПоследних.РационКормления КАК РационКормления
ПОМЕСТИТЬ ВТ_КошкиВПриютеСРационами
ИЗ
	ВТ_КошкиВПриюте КАК ВТ_КошкиВПриюте
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РационыКормленияПодопечных.СрезПоследних(, ) КАК РационыКормленияПодопечныхСрезПоследних
		ПО ВТ_КошкиВПриюте.Кошка = РационыКормленияПодопечныхСрезПоследних.Кошка
;

