Процедура ЕстьНаложениеАдминистративныхМероприятий(ДатаВремя)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГрафикАдминистративныхМероприятий.Мероприятие КАК Мероприятие,
		|	ГрафикАдминистративныхМероприятий.ДатаНачала КАК ДатаНачала,
		|	ГрафикАдминистративныхМероприятий.ДатаНачала КАК ДатаОкончания
		|ИЗ
		|	РегистрСведений.ГрафикАдминистративныхМероприятий КАК ГрафикАдминистративныхМероприятий
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПродолжительностьМероприятий КАК ПродолжительностьМероприятий
		|		ПО ГрафикАдминистративныхМероприятий.Мероприятие = ПродолжительностьМероприятий.Мероприятие
		|ГДЕ
		|	ГрафикАдминистративныхМероприятий.ДатаНачала = &ДатаНачала";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		// Вставить обработку выборки ВыборкаДетальныеЗаписи
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
Выборка.ДатаНачала + (Выборка.Продолжительность - Дата(1,1,1));
	
КонецПроцедуры